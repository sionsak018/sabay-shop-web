VITE_API_BASE_URL=http://localhost:8000/api

# Pusher Channels (real-time chat). The key + cluster must match the backend
# PUSHER_APP_KEY / PUSHER_APP_CLUSTER. Leave blank to fall back to polling.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1

# Google Sign-In (Web OAuth Client ID). Must match the backend GOOGLE_CLIENT_ID.
# When empty the "Continue with Google" button is hidden.
VITE_GOOGLE_CLIENT_ID=
